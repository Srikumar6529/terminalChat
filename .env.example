# Optional local config. Copy to .env and fill in values.
# .env is gitignored. Existing shell environment variables are never overwritten.
#
# Precedence: CLI flags > environment (and .env for unset keys) > built-in defaults
# ANTHROPIC_API_KEY is required and is not accepted as a CLI flag.
# ANTHROPIC_MODEL only sets the default for -model; pass -model to override.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
